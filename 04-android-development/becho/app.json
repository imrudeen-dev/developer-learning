{
  "expo": {
    "name": "Becho Enterprise",
    "slug": "becho",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "becho",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0f19",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0b0f19"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0b0f19"
      },
      "backgroundColor": "#0b0f19"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0b0f19"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#22c55e",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Becho to share your live location with the buyer or seller you choose while this chat is open."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
