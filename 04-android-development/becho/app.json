{
  "expo": {
    "name": "Becho Enterprise",
    "slug": "becho",
    "version": "4.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "becho",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0f19",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0b0f19"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0b0f19"
      },
      "backgroundColor": "#0b0f19",
      "package": "com.imrudeen.becho",
      "versionCode": 6
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0b0f19"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#22c55e",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Becho to share your live location with the buyer or seller you choose while this chat is open."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "imrudeen-studio",
    "extra": {
      "eas": {
        "projectId": "d3f7e3b5-56c8-43b7-a0ef-d1a62f33f0a1"
      }
    }
  }
}
